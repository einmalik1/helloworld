{
  "name": "@helloworld/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p ${STORYBOOK_PORT:-6006} --no-open",
    "build": "storybook build -o storybook-static && cp serve.json storybook-static/serve.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@helloworld/ui": "workspace:*",
    "lucide-react": "0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "@storybook/react": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
