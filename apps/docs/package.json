{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "node ./scripts/sync-openspec.mjs",
    "dev": "pnpm run sync && next dev --port ${DOCS_PORT:-4000}",
    "build": "pnpm run sync && next build",
    "start": "next start --port ${PORT:-${DOCS_PORT:-4000}}",
    "typecheck": "pnpm run sync && next typegen && tsc --noEmit -p tsconfig.json",
    "smoke": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.17",
    "lucide-react": "0.544.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
