    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.0",
    "nestjs-zod": "5.5.0",
    "neverthrow": "8.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.15.3",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
