# Copy to `.env` at the repo root. Do **not** add per-app `.env` files under `apps/` or `tools/`.
# Sections are grouped by service. Apps load configuration from this file when started from the repo root.
# Nest-facing Required / Default / Description: apps/api/README.md § Nest-facing env table.
# No static API_KEY — auth uses Better Auth secrets / managed keys only.

# --- Shared ---
NODE_ENV=development
# Default info (not warn)
LOG_LEVEL=info

# --- Postgres (infra/postgres) ---
# Required for api / worker (and health DB ping).
# Apache AGE uses the same DATABASE_URL on an AGE-enabled custom image
# (CREATE EXTENSION age at bootstrap — see infra/postgres/README.md).
DATABASE_URL=postgresql://helloworld:helloworld@localhost:5432/helloworld

# --- typesense (infra/typesense) ---
# Search index — api + worker S2S only; never expose to browsers/CLI/MCP.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=change-me-typesense-local

# --- Object storage / S3 (infra/s3 — local MinIO-compatible; Coolify Garage in QA/Prod) ---
# Required only when the process touches object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=helloworld
S3_FORCE_PATH_STYLE=true

# --- api (apps/api) ---
API_HOST=0.0.0.0
API_PORT=3000
# Better Auth — required (no static API_KEY)
BETTER_AUTH_SECRET=change-me-in-local-dev
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# --- web (apps/web) ---
WEB_HOST=0.0.0.0
WEB_PORT=5173
# Public URL the browser uses to reach the API (name TBD with bundler)
PUBLIC_API_URL=http://localhost:3000
# Browser → chat service (never a vendor LLM URL)
PUBLIC_CHAT_URL=http://localhost:3200

# --- chat (apps/chat) — LLM only here; see ADR 0008 ---
CHAT_HOST=0.0.0.0
CHAT_PORT=3200
# Local/machine auth stub until Better Auth verify is shared via packages/modules
CHAT_DEV_API_KEY=change-me-chat-local
# LLM adapter: stub | (future: openai, …)
CHAT_LLM_PROVIDER=stub
# CHAT_LLM_API_KEY=
# CHAT_LLM_MODEL=

# --- worker (apps/worker) ---
WORKER_CONCURRENCY=1

# --- mcp (apps/mcp) ---
MCP_HOST=0.0.0.0
MCP_PORT=3100

# --- docs (apps/docs) ---
DOCS_PORT=4000

# --- storybook (apps/storybook) ---
STORYBOOK_PORT=6006

# --- cli / tui (tools/*) ---
# Prefer API_URL / same DATABASE_URL above; add tool-only keys here when needed.

# --- tests (tests/*) ---
# E2E / suite overrides only — reuse service URLs from sections above when possible.
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# VRT_API_URL=
# VRT_PROJECT=
# VRT_API_KEY=
