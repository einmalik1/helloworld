# Copy to `.env` at the repo root. Do **not** add per-app `.env` files under `apps/` or `tools/`.
# Sections are grouped by service. Apps load configuration from this file when started from the repo root.

# --- Shared ---
NODE_ENV=development

# --- Postgres (infra/postgres) ---
DATABASE_URL=postgresql://helloworld:helloworld@localhost:5432/helloworld

# --- Object storage / S3 (infra/s3 — local MinIO-compatible; Coolify Garage in QA/Prod) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=helloworld
S3_FORCE_PATH_STYLE=true

# --- api (apps/api) ---
API_HOST=0.0.0.0
API_PORT=3000
BETTER_AUTH_SECRET=change-me-in-local-dev
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# --- web (apps/web) ---
WEB_HOST=0.0.0.0
WEB_PORT=5173
# Public URL the browser uses to reach the API (name TBD with bundler)
PUBLIC_API_URL=http://localhost:3000

# --- worker (apps/worker) ---
WORKER_CONCURRENCY=1

# --- mcp (apps/mcp) ---
MCP_HOST=0.0.0.0
MCP_PORT=3100

# --- docs (apps/docs) ---
DOCS_PORT=4000

# --- storybook (apps/storybook) ---
STORYBOOK_PORT=6006

# --- cli / tui (tools/*) ---
# Prefer API_URL / same DATABASE_URL above; add tool-only keys here when needed.

# --- tests (tests/*) ---
# E2E / suite overrides only — reuse service URLs from sections above when possible.
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# VRT_API_URL=
# VRT_PROJECT=
# VRT_API_KEY=
