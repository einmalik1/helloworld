{
  "name": "@helloworld/modules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database/schema": {
      "types": "./dist/database/schema/index.d.ts",
      "import": "./dist/database/schema/index.js"
    },
    "./database/auth-schema": {
      "types": "./dist/database/auth-schema.d.ts",
      "import": "./dist/database/auth-schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "vitest run src/nest-di.smoke.spec.ts src/auth/auth.guard.smoke.spec.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "nestjs-pino": "5.3.0",
    "nestjs-zod": "5.5.0",
    "pino": "10.3.1",
    "pino-pretty": "13.2.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.15.3",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
