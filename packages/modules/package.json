{
  "name": "@helloworld/modules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database/schema": {
      "types": "./dist/database/schema/index.d.ts",
      "import": "./dist/database/schema/index.js"
    },
    "./database/auth-schema": {
      "types": "./dist/database/auth-schema.d.ts",
      "import": "./dist/database/auth-schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "typescript": "7.0.2"
  }
}
