{
  "name": "@helloworld/terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "import": "./dist/log/index.js"
    },
    "./tty": {
      "types": "./dist/tty/index.d.ts",
      "import": "./dist/tty/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "env-paths": "4.0.0",
    "ora": "9.4.1",
    "tslog": "5.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "@types/node": "24.7.2",
    "typescript": "7.0.2"
  }
}
