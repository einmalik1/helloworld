{
  "name": "cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "helloworld": "./bin/run.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
