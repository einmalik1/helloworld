  },
  "dependencies": {
    "@helloworld/api-client": "workspace:*",
    "@helloworld/terminal": "workspace:*",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@helloworld/config": "workspace:*",
    "@types/node": "24.7.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
